# Copy to .env for local development (never commit .env).
# In Azure, set these same values as Function App settings instead.

# Public URL of this server. Locally: http://localhost:3000
# In Azure: https://application-tracker-mcp-cre6f4h5grbdc4hq.eastus2-01.azurewebsites.net
PUBLIC_BASE_URL=http://localhost:3000

# Firebase project that holds the tracker data.
FIREBASE_PROJECT_ID=application-tracker-49f9e

# Service-account JSON (single line) for a service account with READ-ONLY
# Firestore access (roles/datastore.viewer). Paste the whole JSON.
# NEVER commit a real value here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"application-tracker-49f9e"}

# Secret used to sign all OAuth tokens (HS256). At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER commit a real value here.
OAUTH_JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# Firebase web config (public client values, same as the tracker app).
# Used only to load the Google sign-in widget on the authorize page.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=application-tracker-49f9e.firebaseapp.com
FIREBASE_WEB_APP_ID=

# Local dev server port.
PORT=3000
